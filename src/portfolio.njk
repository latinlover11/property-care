---
title: "Our Work"
description: "Browse before-and-after photos of Property Care projects across Boulder County and beyond."
ogUrl: "portfolio.html"
root: ""
active: "portfolio"
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>

{% include "icons.njk" %}
{% include "nav.njk" %}

  <main id="main">

    <!-- PAGE HERO -->
    <section class="page-hero">
      <div class="section" style="padding-top:0; padding-bottom:0;">
        <div class="breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <a href="/portfolio">Portfolio</a>
          <span class="sep">/</span>
          <a href="/service-areas">Service Areas</a>
          <span class="sep">/</span>
          <a href="/">Home</a>
        </div>
      </div>
      <h1 class="section-title">Our Work</h1>
      <p class="section-subtitle">Browse before-and-after photos of Property Care projects across Boulder County and beyond.</p>
      <a href="/contact" class="btn-primary">View Projects</a>
      <a href="/portfolio" class="btn-ghost">Back to Home</a>
    </section>

    <!-- PROJECTS GRID -->
    <section class="portfolio-grid">
      {% for project in projects %}
      <article class="portfolio-item" data-service="{{ project.service }}" data-id="{{ project.id }}">
        <div class="portfolio-item-header">
          <img src="{{ project.after.src }}" alt="{{ project.title }}" class="portfolio-image">
          <div class="portfolio-item-footer">
            <span class="portfolio-stars">★★★★☆</span>
            <span class="portfolio-rating">{{ project.rating }}/5</span>
            <a href="/contact" class="btn-primary">View Project</a>
          </div>
        </div>
      </article>
      {% endfor %}
    </section>

    <!-- STATS SECTION -->
    <section class="stats-strip">
      <div class="stats-row">
        <div class="stat-card">
          <span class="stat-number">12</span>
          <span class="stat-label">Projects</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">8</span>
          <span class="stat-label">Years</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">150+</span>
          <span class="stat-label">Happy Clients</span>
        </div>
      </div>
    </section>

    <!-- CTA SECTION -->
    <section class="cta-section">
      <h2 class="section-title">Ready to Transform Your Space?</h2>
      <p class="section-subtitle">Browse our portfolio and find the perfect fit for your property. Each project tells a story of transformation.</p>
      <a href="/contact" class="btn-primary">Get Inspired</a>
      <a href="/portfolio" class="btn-ghost">View All Projects</a>
    </section>

  </main>

  {% include "footer.njk" %}
  {% include "scripts.njk" %}

</body>
</html>
