---
title: "Thanks — We'll Call You Within 24 Hours"
description: "Thank you! Your message has been received. We'll call you within 24 hours."
ogUrl: "success.html"
root: ""
active: "success"
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh;">
<a href="#main" class="skip-link">Skip to main content</a>

{% include "icons.njk" %}
{% include "nav.njk" %}

  <main id="main" style="flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; padding: 4rem 2rem;">
    <div style="max-width: 600px;">
      <h2 class="section-title">Thanks — we'll call you within 24 hours</h2>
      <p style="margin-bottom: 2rem; color: var(--warm-mid);">Your message is in. We'll follow up shortly with availability and a clear estimate. Need us sooner? Call <a href="tel:{{ site.phone }}" style="color: var(--clay); font-weight: 600;">{{ site.phoneDisplay }}</a>.</p>

      <div class="review-prompt" style="margin: 0 auto 2rem; max-width: 480px; text-align: left; border: 1px solid rgba(61,43,31,0.12); border-radius: 12px; padding: 1.75rem;">
        <p class="section-label" style="margin-bottom: 0.5rem;">Loved our work?</p>
        <h3 style="font-family:'Playfair Display', serif; color:var(--bark); margin: 0 0 0.75rem;">Leave a quick review</h3>
        <p style="color: var(--warm-mid); font-size: 0.9rem; margin: 0 0 1.25rem;">Your feedback helps us keep raising the bar. It takes under a minute.</p>
        <form class="review-form" id="reviewForm" name="review" method="POST" action="{{ root }}submit-form">
          <input type="hidden" name="form-name" value="review" />
          <input type="text" name="bot-field" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true">
          <div class="form-group" style="margin-bottom: 0.9rem;">
            <label for="rating" style="display:block; font-weight:600; margin-bottom:0.4rem; font-size:0.9rem;">Your rating</label>
            <select id="rating" name="rating" required style="width:100%; padding:0.7rem 0.8rem; border:1px solid #d4c9bc; border-radius:6px; background:#fff; color:var(--bark);">
              <option value="">Select…</option>
              <option value="5">★★★★★ 5 — Excellent</option>
              <option value="4">★★★★ 4 — Great</option>
              <option value="3">★★★ 3 — Good</option>
              <option value="2">★★ 2 — Fair</option>
              <option value="1">★ 1 — Poor</option>
            </select>
          </div>
          <div class="form-group" style="margin-bottom: 0.9rem;">
            <label for="name" style="display:block; font-weight:600; margin-bottom:0.4rem; font-size:0.9rem;">Your name</label>
            <input type="text" id="review-name" name="name" placeholder="First name or last initial" required style="width:100%; padding:0.7rem 0.8rem; border:1px solid #d4c9bc; border-radius:6px; background:#fff; color:var(--bark);">
          </div>
          <div class="form-group" style="margin-bottom: 0.9rem;">
            <label for="service-type" style="display:block; font-weight:600; margin-bottom:0.4rem; font-size:0.9rem;">Service (optional)</label>
            <select id="service-type" name="service-type" style="width:100%; padding:0.7rem 0.8rem; border:1px solid #d4c9bc; border-radius:6px; background:#fff; color:var(--bark);">
              <option value="">Select a service…</option>
              {% for s in services %}
              <option value="{{ s.title }}">{{ s.title }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="form-group" style="margin-bottom: 0.9rem;">
            <label for="review" style="display:block; font-weight:600; margin-bottom:0.4rem; font-size:0.9rem;">Your review</label>
            <textarea id="review" name="review" rows="4" placeholder="Tell us about your experience…" required style="width:100%; padding:0.7rem 0.8rem; border:1px solid #d4c9bc; border-radius:6px; background:#fff; color:var(--bark); resize:vertical;"></textarea>
          </div>
          <div class="cf-turnstile" data-sitekey="0x4AAAAAAETW15T6VEdnpxQx" data-action="review" style="margin-bottom: 1rem;"></div>
          <button type="submit" class="btn-primary" style="width:100%; justify-content:center;">Submit Review</button>
        </form>
      </div>

      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="index.html" class="btn-primary">Return Home</a>
        <a href="services.html" class="btn-ghost">Browse Services</a>
        <a href="portfolio.html" class="btn-ghost">See Our Work</a>
      </div>
    </div>
  </main>

{% include "footer.njk" %}
{% include "scripts.njk" %}

</body>
</html>