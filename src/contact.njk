---
title: "Contact"
description: "Get a free, no-obligation estimate from Property Care. Tell us about your project and we'll respond within 24 hours with availability and a clear, itemized estimate."
ogUrl: "contact.html"
root: ""
active: "contact"
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>

{% include "icons.njk" %}
{% include "nav.njk" %}
<main id="main">

  <section class="page-hero" style="position:relative; overflow:hidden;">
    <div style="position:absolute; inset:0; background:linear-gradient(135deg, rgba(61,43,31,0.45) 0%, transparent 100%); pointer-events:none;"></div>
    <div style="position:absolute; inset:0; opacity:0.04; background-image:url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;); background-size:256px; pointer-events:none;"></div>
    <div class="section" style="padding-top:0; padding-bottom:0; position:relative; z-index:1;">
      <div class="breadcrumb">
        <a href="index.html">Home</a>
        <span class="sep">/</span>
        <span class="current">Contact</span>
      </div>
      <p class="section-label" style="font-size:0.82rem; letter-spacing:0.1em;">Get in Touch</p>
      <h1 class="section-title" style="font-size:clamp(2.2rem,5vw,3.2rem); max-width:700px;">Let's talk about your <em>project</em></h1>
      <div style="width:40px; height:3px; background:var(--clay); border-radius:2px; margin-top:1.5rem;"></div>
    </div>
  </section>

  <!-- CONTACT (Clean Light Card Layout) -->
  <section id="contact" class="contact-section--light">
    <div class="section">
      <p class="section-label">Get a Free Estimate</p>
      <h2 class="section-title">Tell us about <em>your project</em></h2>
      <div class="contact-layout">
        <div class="contact-intro" data-aos="fade-right">
          <p style="font-size:0.95rem; margin-bottom:1.5rem;">Serving all 13 communities around Boulder County — <a href="service-areas.html" style="color:var(--clay-deep); font-weight:600;">check if we cover your town</a>.</p>
          <p style="font-size:1.05rem; margin-bottom:2rem; color:var(--bark);">Whether it's a one-time job or regular maintenance, fill out the form and we'll respond with availability and a clear estimate.</p>
          <div class="contact-detail">
            <svg class="icon" style="width:1.1rem;height:1.1rem;flex-shrink:0;"><use href="#icon-phone"/></svg>
            <div><strong>Call</strong> <a href="tel:{{ site.phone }}">{{ site.phoneDisplay }}</a></div>
          </div>

          <div class="contact-detail">
            <svg class="icon" style="width:1.1rem;height:1.1rem;flex-shrink:0;"><use href="#icon-chat"/></svg>
            <div><strong>Text</strong> <a href="sms:{{ site.phone }}">{{ site.phoneDisplay }}</a></div>
          </div>

          <div class="contact-detail">
            <svg class="icon" style="width:1.1rem;height:1.1rem;flex-shrink:0;"><use href="#icon-mail"/></svg>
            <div><strong>Email</strong> <a href="mailto:{{ site.email }}">Email Us</a></div>
          </div>

          <div class="contact-detail">
            <svg class="icon" style="width:1.1rem;height:1.1rem;flex-shrink:0;"><use href="#icon-pin"/></svg>
            <div><strong>Service Area</strong> {% for area in areas %}{{ area.name }}{% if not loop.last %}{{ ', and ' if loop.revindex == 2 else ', ' }}{% endif %}{% endfor %}</div>
          </div>
          <div style="margin-top:2rem; padding-top:1.5rem; border-top:1px solid rgba(61,43,31,0.1);">
            <p style="font-size:0.85rem; color:rgba(61,43,31,0.6); margin:0;">✓ We typically respond within 24 hours.</p>
          </div>
        </div>

        <form class="contact-form" name="contact" method="POST" action="{{ root }}submit-form" data-aos="fade-left" data-contact-form>
          <input type="hidden" name="form-name" value="contact" />
          <input type="text" name="bot-field" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true">
          <h3 style="font-family:'Playfair Display',serif; color:var(--bark); font-size:1.3rem; margin:0 0 0.25rem;">Request a Free Quote</h3>
          <div class="form-row">
            <div class="form-group">
              <label for="name">Full name *</label>
              <input type="text" id="name" name="name" placeholder="Jane Smith" required autocomplete="name">
            </div>
            <div class="form-group">
              <label for="phone">Phone *</label>
              <input type="tel" id="phone" name="phone" placeholder="(720) 000-0000" required autocomplete="tel">
            </div>
          </div>
          <div class="form-group">
            <label for="address">Property address *</label>
            <input type="text" id="address" name="address" placeholder="123 Maple Ave, Longmont, CO" required autocomplete="street-address">
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email">
          </div>
          <div class="form-group">
            <label for="service-type">Service needed *</label>
            <select id="service-type" name="service-type" required data-service-select>
              <option value="">Select a service…</option>
              {% for s in services %}
              <option value="{{ s.title }}" data-slug="{{ s.slug }}">{{ s.title }}</option>
              {% endfor %}
              <option value="Not sure / Other">Not sure / Other</option>
            </select>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="preferred-date">Preferred date</label>
              <input type="date" id="preferred-date" name="preferred-date">
            </div>
            <div class="form-group">
              <label for="when">When?</label>
              <select id="when" name="when">
                <option>As soon as possible</option>
                <option>This week</option>
                <option>Next 2 weeks</option>
                <option>Just exploring</option>
              </select>
            </div>
          </div>
          <div class="form-group" data-estimate-field hidden>
            <label for="estimate">Estimated range from calculator</label>
            <input type="text" id="estimate" name="estimate" readonly data-estimate-input>
          </div>
          <div class="form-group">
            <label for="message">Tell us about the job *</label>
            <textarea id="message" name="message" rows="4" placeholder="e.g. Rotting fence posts near the back gate, need about 60 ft replaced…" required></textarea>
          </div>
          <label class="consent">
            <input type="checkbox" name="consent" value="yes" required>
            <span>I agree to be contacted about my request. No spam, ever.</span>
          </label>
          <div class="cf-turnstile" data-sitekey="0x4AAAAAAETW15T6VEdnpxQx" data-action="contact"></div>
          <button type="submit" class="btn-primary" style="width:100%; justify-content:center; padding:0.95rem 1.5rem; font-size:0.95rem;">Send My Request — Free Quote →</button>
          <p class="form-note" data-form-note>We reply within one business day.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- SERVICE AREA (Warm Sand Accent Background) -->
  <section id="service-area" style="background:var(--straw);">
    <div class="section">
      <div class="area-layout">
        <div>
          <p class="section-label" style="color:var(--clay-deep);">Where We Serve</p>
          <h2 class="section-title" style="color:var(--bark);">Proudly serving Boulder County <em>&amp; beyond</em></h2>
          <p style="line-height:1.7; color:rgba(61,43,31,0.75); max-width:480px;">From the foothills of Lyons to the Carbon Valley — we bring the same reliability to every job across the region.</p>
        </div>
        <div class="area-communities">
          <h3 style="color:var(--bark); font-family:'Playfair Display',serif; font-size:1.05rem; margin-bottom:1rem;">Communities Served</h3>
          <ul class="area-list">
            {% for area in areas %}
            <li><a href="service-areas/{{ area.slug }}" style="color:inherit; text-decoration:none;"><svg class="icon icon-sm"><use href="#icon-pin"/></svg>{{ area.name }}</a></li>
            {% endfor %}
          </ul>
        </div>
        <div class="area-map">
          <div class="area-map-clip" style="border-radius:12px; overflow:hidden; border:1px solid rgba(61,43,31,0.12); box-shadow:0 8px 24px rgba(61,43,31,0.06);">
            <iframe src="https://www.google.com/maps?q=Longmont,+CO&z=10&output=embed" title="Map of communities served by Property Care around Longmont, Colorado" width="100%" height="460" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
          <p class="area-map-caption" style="margin-top:0.75rem; color:rgba(61,43,31,0.7);"><strong>Longmont, CO</strong> — serving all 13 communities across Boulder County &amp; the Front Range. <a href="service-areas.html" style="color:var(--clay-deep); font-weight:600;">See full list of communities</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS (Rich Dark Accent Section) -->
  <section id="process" style="background:var(--bark); position:relative; overflow:hidden;">
    <div style="position:absolute; inset:0; opacity:0.04; background-image:url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;); background-size:256px; pointer-events:none;"></div>
    <div class="section" style="position:relative; z-index:1;">
      <p class="section-label" style="color:var(--clay);">Simple Process</p>
      <h2 class="section-title" style="color:var(--straw);">What happens <em>next</em></h2>
      <div class="steps-grid" data-aos="fade-up" style="max-width:none;">
        <div class="step-card" style="background:rgba(255,255,255,0.04); border:1px solid rgba(245,240,232,0.12); border-radius:12px; padding:2rem;">
          <div style="width:44px; height:44px; border-radius:50%; background:var(--clay); color:var(--cream); font-weight:700; font-size:1.15rem; display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem; box-shadow:0 4px 12px rgba(196,151,122,0.3);">1</div>
          <h3 style="font-size:1.2rem; color:var(--cream); font-family:'Playfair Display',serif; margin-bottom:0.5rem;">Tell us what you need</h3>
          <p style="font-size:0.95rem; color:rgba(245,240,232,0.7); line-height:1.65;">Share project details through our online form, an email, or a quick phone call.</p>
        </div>
        <div class="step-card" style="background:rgba(255,255,255,0.04); border:1px solid rgba(245,240,232,0.12); border-radius:12px; padding:2rem;">
          <div style="width:44px; height:44px; border-radius:50%; background:var(--clay); color:var(--cream); font-weight:700; font-size:1.15rem; display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem; box-shadow:0 4px 12px rgba(196,151,122,0.3);">2</div>
          <h3 style="font-size:1.2rem; color:var(--cream); font-family:'Playfair Display',serif; margin-bottom:0.5rem;">Get a clear estimate</h3>
          <p style="font-size:0.95rem; color:rgba(245,240,232,0.7); line-height:1.65;">We review your scope and respond within 24 hours with an honest, itemized breakdown.</p>
        </div>
        <div class="step-card" style="background:rgba(255,255,255,0.04); border:1px solid rgba(245,240,232,0.12); border-radius:12px; padding:2rem;">
          <div style="width:44px; height:44px; border-radius:50%; background:var(--clay); color:var(--cream); font-weight:700; font-size:1.15rem; display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem; box-shadow:0 4px 12px rgba(196,151,122,0.3);">3</div>
          <h3 style="font-size:1.2rem; color:var(--cream); font-family:'Playfair Display',serif; margin-bottom:0.5rem;">We handle the rest</h3>
          <p style="font-size:0.95rem; color:rgba(245,240,232,0.7); line-height:1.65;">Once approved, we schedule and execute the work with precision and a full clean-up.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BADGES -->
  <section id="trust" style="background:var(--cream);">
    <div class="section" style="padding:3.5rem 1.5rem;">
      <div class="trust-badges">
        <div class="trust-badge" style="background:#ffffff; border:1px solid rgba(61,43,31,0.08); border-radius:10px; padding:1.5rem; box-shadow:0 4px 14px rgba(61,43,31,0.03);">
          <div class="badge-icon" style="color:var(--clay-deep);"><svg class="icon"><use href="#icon-shield"/></svg></div>
          <p style="color:var(--bark);"><strong>Licensed & Insured</strong><br><small style="color:rgba(61,43,31,0.65);">Full liability coverage</small></p>
        </div>
        <div class="trust-badge" style="background:#ffffff; border:1px solid rgba(61,43,31,0.08); border-radius:10px; padding:1.5rem; box-shadow:0 4px 14px rgba(61,43,31,0.03);">
          <div class="badge-icon" style="color:var(--clay-deep);"><svg class="icon"><use href="#icon-star"/></svg></div>
          <p style="color:var(--bark);"><strong>5-Star Rated</strong><br><small style="color:rgba(61,43,31,0.65);">Serving local homeowners since 2014</small></p>
        </div>
        <div class="trust-badge" style="background:#ffffff; border:1px solid rgba(61,43,31,0.08); border-radius:10px; padding:1.5rem; box-shadow:0 4px 14px rgba(61,43,31,0.03);">
          <div class="badge-icon" style="color:var(--clay-deep);"><svg class="icon"><use href="#icon-people"/></svg></div>
          <p style="color:var(--bark);"><strong>Local & Reliable</strong><br><small style="color:rgba(61,43,31,0.65);">Boulder County &amp; beyond</small></p>
        </div>
        <div class="trust-badge" style="background:#ffffff; border:1px solid rgba(61,43,31,0.08); border-radius:10px; padding:1.5rem; box-shadow:0 4px 14px rgba(61,43,31,0.03);">
          <div class="badge-icon" style="color:var(--clay-deep);"><svg class="icon"><use href="#icon-bolt"/></svg></div>
          <p style="color:var(--bark);"><strong>Quick Response</strong><br><small style="color:rgba(61,43,31,0.65);">24-hour reply guarantee</small></p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="cta" style="background:linear-gradient(135deg, #3D2B1F 0%, #2A1D14 100%); position:relative; overflow:hidden;">
    <div style="position:absolute; inset:0; opacity:0.04; background-image:url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;); background-size:256px; pointer-events:none;"></div>
    <div class="section" style="text-align:center; position:relative; z-index:1; padding:4rem 1.5rem;">
      <h2 class="section-title" style="color:var(--cream);">Rather talk it through?</h2>
      <p style="color:var(--straw); max-width:520px; margin:0 auto 2rem; font-size:1.05rem;">Prefer to chat directly? Call <a href="tel:{{ site.phone }}" style="color:var(--clay); font-weight:600;">{{ site.phoneDisplay }}</a> or <a href="mailto:{{ site.email }}" style="color:var(--clay); font-weight:600;">email us</a> — we respond within 24 hours.</p>
      <div style="display:flex; gap:1rem; justify-center; justify-content:center; flex-wrap:wrap;">
        <a href="tel:{{ site.phone }}" class="btn-primary" style="display:inline-flex; align-items:center; gap:0.5rem;">
          <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 10a16 16 0 0 0 6 6l1.4-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          Call {{ site.phoneDisplay }}
        </a>
        <a href="mailto:{{ site.email }}" class="btn-ghost" style="display:inline-flex; align-items:center; gap:0.5rem; color:var(--cream); border-color:rgba(245,240,232,0.3);">
          Email Us Directly
        </a>
      </div>
    </div>
  </section>

</main>
{% include "footer.njk" %}
{% include "scripts.njk" %}

</body>
</html>