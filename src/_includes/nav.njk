<header class="nav">
  <div class="nav-inner">
    <a href="{{ root }}index.html" class="nav-logo">Property<span>Care</span></a>
    
    <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="navMenu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav-links" id="navMenu">
      <ul class="nav-links-group">
        <li><a href="{{ root }}index.html" class="nav-link{% if active == 'home' %} active{% endif %}"{% if active == 'home' %} aria-current="page"{% endif %}>Home</a></li>
        <li><a href="{{ root }}portfolio.html" class="nav-link{% if active == 'portfolio' %} active{% endif %}"{% if active == 'portfolio' %} aria-current="page"{% endif %}>Portfolio</a></li>
        <li class="dropdown">
          <button class="dropdown-trigger{% if active == 'services' %} is-current{% endif %}" aria-haspopup="true" aria-expanded="false">
            Services <span class="arrow">▼</span>
          </button>
          <ul class="dropdown-menu">
            {% for service in services %}
            <li><a href="{{ root }}services/{{ service.slug }}.html">{{ service.title }}</a></li>
            {% endfor %}
            <li><a href="{{ root }}services.html" style="color:var(--clay); border-top:1px solid rgba(245,240,232,0.1); margin-top:0.25rem; padding-top:0.75rem;">View All Services →</a></li>
          </ul>
        </li>
        <li><a href="{{ root }}about.html" class="nav-link{% if active == 'about' %} active{% endif %}"{% if active == 'about' %} aria-current="page"{% endif %}>About</a></li>
      </ul>
      <a href="tel:{{ site.phone }}" class="nav-call" aria-label="Call us">
        <svg viewBox="0 0 24 24" fill="none" width="14" height="14" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 10a16 16 0 0 0 6 6l1.4-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        </svg>
      </a>
      <a href="mailto:{{ site.email }}" class="nav-mail" aria-label="Email us">
        <svg viewBox="0 0 24 24" fill="none" width="14" height="14" aria-hidden="true">
          <rect x="2.5" y="4.5" width="19" height="15" rx="2" stroke="currentColor" stroke-width="1.8"/>
          <path d="M3 6L12 13L21 6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="{{ root }}contact.html" class="nav-cta">
        <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use href="#icon-clipboard-check"/></svg>
        Get Estimate
      </a>
    </nav>
  </div>
</header>
