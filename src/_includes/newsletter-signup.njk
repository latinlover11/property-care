<section style="background:var(--cream); padding: 3.5rem 2.5rem;">
  <div class="section" style="text-align:center;">
    <p class="section-label">Stay in the Loop</p>
    <h2 class="section-title" style="color:var(--bark);">Get seasonal tips &amp; <em style="color:var(--clay-deep);">updates</em></h2>
    <p style="color:var(--bark); font-size:0.95rem; opacity:0.8; max-width:460px; margin:1rem auto 1.5rem;">Join our mailing list for seasonal tips, occasional offers, and new-service updates — no spam, unsubscribe anytime.</p>
    <form class="newsletter-form" id="newsletterFormInline" name="newsletter" method="POST" action="{{ root }}submit-form" style="max-width:460px; margin:0 auto;">
      <input type="hidden" name="form-name" value="newsletter" />
      <input type="text" name="bot-field" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true">
      <input type="email" name="email" placeholder="your@email.com" required>
      <button type="submit" class="btn-primary">Subscribe</button>
      <label class="newsletter-consent">
        <input type="checkbox" name="consent" value="yes" required>
        <span>I agree to receive occasional updates per our <a href="/privacy">privacy policy</a>.</span>
      </label>
    </form>
  </div>
</section>
