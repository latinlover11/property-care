<section style="background:var(--straw); padding: 3.5rem 2.5rem;">
  <div class="section" style="text-align:center;">
    <p class="section-label" style="color:var(--clay);">Service Areas</p>
    <h2 class="section-title">Communities we <em>serve</em></h2>
    <p style="color:rgba(61,43,31,0.6); max-width:560px; margin:0 auto 2rem; line-height:1.7;">Reliable property care across the Front Range — explore what we offer in your neighborhood.</p>
    <div class="area-grid">
      {% for area in areas %}
      <a class="area-card" href="/service-areas/{{ area.slug }}" style="text-decoration:none; display:block;">
        <h3>{{ area.name }}</h3>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
