<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#3D2B1F">
<title>{{ title }} — {{ site.name }} | Longmont &amp; Boulder</title>
{% set ogImg = ogImage or site.ogImage %}
<meta name="description" content="{{ description }}">
<meta property="og:title" content="{{ title }} — {{ site.name }} | Longmont &amp; Boulder">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.domain }}/{{ ogUrl | cleanUrl }}">
{% set _og = ogImg %}{% if _og.startsWith('/') %}{% set _og = _og.slice(1) %}{% endif %}
<meta property="og:image" content="{% if _og.startsWith('http') %}{{ _og }}{% else %}{{ site.domain }}/{{ _og }}{% endif %}">
<link rel="canonical" href="{{ site.domain }}/{{ ogUrl | cleanUrl }}">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }} — {{ site.name }} | Longmont & Boulder">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{% if _og.startsWith('http') %}{{ _og }}{% else %}{{ site.domain }}/{{ _og }}{% endif %}">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{ site.name }}",
  "description": "Professional property maintenance serving Longmont, Boulder, Lafayette, Louisville, Loveland, Lyons, Niwot, Berthoud, Broomfield, Brighton, Johnstown, Firestone, and Frederick.",
  "url": "{{ site.domain }}",
  "telephone": "{{ site.phone }}",
  "image": "{{ site.ogImage }}",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Longmont",
    "addressRegion": "CO",
    "addressCountry": "US"
  },
  "areaServed": [
    {% for area in areas %}
    { "@type": "City", "name": "{{ area.name }}" }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "priceRange": "$$",
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "08:00",
    "closes": "18:00"
  }
}
</script>

{% if faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faq %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

{% if breadcrumbs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {% for item in breadcrumbs %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "name": {{ item.name | dump | safe }},
      "item": "{{ site.domain }}{{ item.url }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

{% if page.url and page.url.startsWith('/services/') %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "url": "{{ site.domain }}/{{ ogUrl | cleanUrl }}",
  "serviceType": {{ title | dump | safe }},
  "provider": {
    "@type": "LocalBusiness",
    "name": {{ site.name | dump | safe }},
    "url": "{{ site.domain }}",
  "telephone": "{{ site.phone }}",
  "email": "{{ site.email }}",
    "address": { "@type": "PostalAddress", "addressLocality": "Longmont", "addressRegion": "CO", "addressCountry": "US" }
  },
  "areaServed": [
    {% for area in areas %}{ "@type": "City", "name": {{ area.name | dump | safe }} }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "offers": { "@type": "Offer", "priceCurrency": "USD", "url": "{{ site.domain }}/contact" }
}
</script>
{% endif %}

