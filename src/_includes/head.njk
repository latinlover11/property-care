<script defer src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad"></script>
<script>
  window.onTurnstileLoad = function () {
    if (!window.turnstile) return;
    document.querySelectorAll('.cf-turnstile').forEach(function (el) {
      var form = el.closest('form');
      var id = window.turnstile.render(el, {
        sitekey: el.dataset.sitekey,
        action: el.dataset.action || 'form',
        theme: el.dataset.theme || 'auto'
      });
      var widgets = window.__turnstileWidgets || (window.__turnstileWidgets = {});
      widgets[form ? form.getAttribute('id') || form.name || el.dataset.action : el.dataset.action] = id;
    });
  };
</script>
