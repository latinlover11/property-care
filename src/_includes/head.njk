<meta charset="UTF-8">
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-PCL5716RE7"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-PCL5716RE7');
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#3D2B1F">
<title>{{ title }} — {{ site.name }} | Longmont &amp; Boulder</title>
<meta name="description" content="{{ description }}">
<meta property="og:title" content="{{ title }} — {{ site.name }} | Longmont &amp; Boulder">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.domain }}/{{ ogUrl | cleanUrl }}">
<meta property="og:image" content="{{ ogImage or site.ogImage }}">
<link rel="canonical" href="{{ site.domain }}/{{ ogUrl | cleanUrl }}">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }} — {{ site.name }} | Longmont & Boulder">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ ogImage or site.ogImage }}">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{ site.name }}",
  "description": "Professional property maintenance serving Longmont, Boulder, Lafayette, Louisville, Loveland, Lyons, Niwot, Berthoud, Broomfield, Brighton, Johnstown, Firestone, and Frederick.",
  "url": "{{ site.domain }}",
  "telephone": "{{ site.phone }}",
  "image": "{{ site.ogImage }}",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Longmont",
    "addressRegion": "CO",
    "addressCountry": "US"
  },
  "areaServed": [
    {% for area in areas %}
    { "@type": "City", "name": "{{ area.name }}" }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "priceRange": "$$",
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "08:00",
    "closes": "18:00"
  }
}
</script>

{% if faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faq %}
    {
      "@type": "Question",
      "name": {{ item.q | dump }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

{% if breadcrumbs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {% for item in breadcrumbs %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "name": {{ item.name | dump }},
      "item": "{{ site.domain }}{{ item.url }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

