---
title: "Home"
description: "Property Care provides honest, reliable lawn mowing, fence installation, hardscaping, exterior care, and handyman services across Longmont and the Boulder County Front Range — free estimates, lasting results."
ogUrl: ""
ogImage: "images/after/lawn-after.webp"
root: ""
active: "home"
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Do you provide estimates?", "acceptedAnswer": { "@type": "Answer", "text": "Yes! We offer free, no-obligation estimates for all services. Contact us or fill out the form to request one." } },
      { "@type": "Question", "name": "Are you licensed and insured?", "acceptedAnswer": { "@type": "Answer", "text": "Absolutely. We're fully licensed, insured, and bonded to protect you and your property." } },
      { "@type": "Question", "name": "What areas do you serve?", "acceptedAnswer": { "@type": "Answer", "text": "We serve Longmont, Boulder, Lafayette, Louisville, Loveland, Lyons, Niwot, Berthoud, Broomfield, Brighton, Johnstown, Firestone, and Frederick. Contact us to see if your area is covered." } },
      { "@type": "Question", "name": "Can you work on weekends?", "acceptedAnswer": { "@type": "Answer", "text": "We work Saturday mornings by request. Sunday is our rest day. Contact us to arrange weekend scheduling." } },
      { "@type": "Question", "name": "How do I schedule a service?", "acceptedAnswer": { "@type": "Answer", "text": "Call us at (720) 707-5411 or use the contact form. We respond within 24 hours." } },
      { "@type": "Question", "name": "What payment methods do you accept?", "acceptedAnswer": { "@type": "Answer", "text": "We accept cash, check, Venmo, and all major credit cards. Invoice billing available for regular clients." } }
    ]
  }
  </script>
  <style>
    #trust .trust-badge p { color: var(--straw); }
    #trust .trust-badge strong { color: var(--cream); }
    #trust .trust-badge small { color: rgba(245,240,232,0.6); }
    #contact .contact-intro p { color: rgba(245,240,232,0.75); }
    #contact .contact-detail strong,
    #contact .contact-detail a,
    #contact .form-group label { color: var(--straw); }
    #contact .form-group input,
    #contact .form-group textarea { background: rgba(245,240,232,0.08); border-color: rgba(245,240,232,0.2); color: var(--straw); }
    #contact .form-group input::placeholder,
    #contact .form-group textarea::placeholder { color: rgba(245,240,232,0.4); }
    #newsletter .newsletter-form input[type="email"] { background:#fff; border-color:#d4c9bc; color:var(--bark); }
    #newsletter .newsletter-form input[type="email"]::placeholder { color:#a89888; }
  </style>
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>

{% include "icons.njk" %}
{% include "nav.njk" %}
<main id="main">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-rule"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Longmont · Boulder · Niwot · Berthoud</p>
      <h1>Honest work.<br><em>Lasting</em> results.</h1>
      <p class="hero-sub">Professional property maintenance — from crisp lawn edges to durable outdoor repairs. Every detail, done right.</p>
      <div class="hero-contact">
        <a href="tel:{{ site.phone }}" class="hero-phone">
          <svg viewBox="0 0 24 24" class="icon icon-sm" aria-hidden="true"><use href="#icon-phone"/></svg>
          Call
        </a>
        <span class="hero-contact-sep" aria-hidden="true">·</span>
        <a href="sms:{{ site.phone }}" class="hero-phone">
          <svg viewBox="0 0 24 24" class="icon icon-sm" aria-hidden="true"><use href="#icon-chat"/></svg>
          Text us
        </a>
      </div>
      <div class="hero-actions">
        <a href="#contact" class="btn-primary">Get a Free Estimate</a>
        <a href="/services" class="btn-ghost">See Our Services</a>
        <a href="privacy-fence-case-study" class="btn-ghost">View Case Study</a>
      </div>
    </div>
  </section>

  <!-- STRIP -->
  <div class="strip">
    <div class="strip-track">
      <span>Lawn Mowing</span><span>Fence Installation</span><span>Property Cleanups</span>
      <span>Hardscaping</span><span>Exterior Care</span><span>Custom Carpentry</span>
      <span>Interior Handyman</span><span>Gutter Maintenance</span>
      <span>Lawn Mowing</span><span>Fence Installation</span><span>Property Cleanups</span>
      <span>Hardscaping</span><span>Exterior Care</span><span>Custom Carpentry</span>
      <span>Interior Handyman</span><span>Gutter Maintenance</span>
    </div>
  </div>

  <!-- TRUST BADGES -->
  <section id="trust" style="background:var(--bark);">
    <div class="section" style="padding:3rem 2.5rem;">
      <div class="trust-badges">
        <div class="trust-badge">
          <div class="badge-icon"><svg class="icon"><use href="#icon-shield"/></svg></div>
          <p><strong>Licensed & Insured</strong><br><small>Full coverage protection</small></p>
        </div>
        <div class="trust-badge">
          <div class="badge-icon"><svg class="icon"><use href="#icon-star"/></svg></div>
          <p><strong>5-Star Rated</strong><br><small>Serving local homeowners since 2014</small></p>
        </div>
        <div class="trust-badge">
          <div class="badge-icon"><svg class="icon"><use href="#icon-people"/></svg></div>
          <p><strong>Local & Reliable</strong><br><small>Boulder County &amp; beyond</small></p>
        </div>
        <div class="trust-badge">
          <div class="badge-icon"><svg class="icon"><use href="#icon-bolt"/></svg></div>
          <p><strong>Quick Response</strong><br><small>24-hour reply guarantee</small></p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section style="background:var(--cream);">
    <div class="section">
      <p class="section-label">How It Works</p>
      <h2 class="section-title">From quote to <em>finished</em></h2>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Free Estimate</h3>
          <p>Call or fill out the form. We'll discuss your project, answer questions, and provide a no-obligation quote.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>We Schedule</h3>
          <p>Pick a time that works for you. We'll arrive on schedule and get straight to work.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>We Deliver</h3>
          <p>We complete the work with attention to detail, clean up thoroughly, and make sure you're happy.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- INSTANT ESTIMATOR -->
  <section id="estimator" style="background:var(--bark); position:relative; overflow:hidden;">
    <div style="position:absolute; inset:0; opacity:0.04; background-image:url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;); background-size:256px; pointer-events:none;"></div>
    <div class="section" style="position:relative; z-index:1;">
      <div style="text-align:center; max-width:620px; margin:0 auto 3rem;">
        <p class="section-label" style="color:var(--clay);">Instant Quote</p>
        <h2 class="section-title" style="color:var(--straw);">Build your estimate in <em style="color:var(--clay);">30 seconds</em></h2>
        <p style="color:rgba(245,240,232,0.65); font-size:1.05rem; line-height:1.7;">Three quick steps. Pick your service, tell us about the job, and get an instant price range — no phone call required.</p>
      </div>

      <div class="quote-wizard" id="quote-wizard">
        <ol class="wizard-steps" aria-label="Quote form progress">
          <li class="wizard-step is-active" data-step-indicator="1">
            <span class="wizard-dot" data-dot="1">1</span>
            <span class="wizard-label">Service</span>
          </li>
          <li class="wizard-line" aria-hidden="true"></li>
          <li class="wizard-step" data-step-indicator="2">
            <span class="wizard-dot" data-dot="2">2</span>
            <span class="wizard-label">Details</span>
          </li>
          <li class="wizard-line" aria-hidden="true"></li>
          <li class="wizard-step" data-step-indicator="3">
            <span class="wizard-dot" data-dot="3">3</span>
            <span class="wizard-label">Estimate</span>
          </li>
        </ol>

        <!-- STEP 1: SERVICE -->
        <div class="wizard-panel" data-step="1">
          <p class="wizard-hint">Step 1 of 3 · Choose your service</p>
          <div class="wizard-services">
            <button type="button" class="wizard-service" data-service="lawn-mowing-care" aria-pressed="false">
              <span class="wizard-service-icon" aria-hidden="true">🌿</span>
              <strong>Lawn Mowing &amp; Care</strong>
              <small>Lawns, edging &amp; seasonal turf care</small>
            </button>
            <button type="button" class="wizard-service" data-service="fence-installation" aria-pressed="false">
              <span class="wizard-service-icon" aria-hidden="true">🚧</span>
              <strong>Fence Installation</strong>
              <small>New fences, gates &amp; repairs</small>
            </button>
            <button type="button" class="wizard-service" data-service="property-cleanups" aria-pressed="false">
              <span class="wizard-service-icon" aria-hidden="true">🧹</span>
              <strong>Property Cleanups</strong>
              <small>Spring &amp; fall cleanups, debris</small>
            </button>
            <button type="button" class="wizard-service" data-service="hardscaping" aria-pressed="false">
              <span class="wizard-service-icon" aria-hidden="true">🧱</span>
              <strong>Hardscaping</strong>
              <small>Patio repairs, walls, walkways</small>
            </button>
            <button type="button" class="wizard-service" data-service="exterior-care" aria-pressed="false">
              <span class="wizard-service-icon" aria-hidden="true">🪟</span>
              <strong>Exterior Care</strong>
              <small>Windows, washing, gutters</small>
            </button>
          </div>
        </div>

        <!-- STEP 2: DETAILS -->
        <div class="wizard-panel" data-step="2" hidden>
          <p class="wizard-hint">Step 2 of 3 · Project details</p>
          <div class="wizard-field">
            <label class="wizard-label" for="wizard-size">Approximate size *</label>
            <input id="wizard-size" type="number" min="1" max="100000" inputmode="numeric" placeholder="e.g. 2000" data-field="size">
            <small class="wizard-unit-note" data-unit-note>square feet</small>
          </div>
          <fieldset class="wizard-group">
            <legend class="wizard-label">Property type *</legend>
            <div class="wizard-radios">
              <label class="wizard-radio">
                <input type="radio" name="property_type" value="front_yard">
                <span>Front Yard</span>
              </label>
              <label class="wizard-radio">
                <input type="radio" name="property_type" value="back_yard">
                <span>Back Yard</span>
              </label>
              <label class="wizard-radio">
                <input type="radio" name="property_type" value="full_property">
                <span>Full Property</span>
              </label>
            </div>
          </fieldset>
          <fieldset class="wizard-group">
            <legend class="wizard-label">Extras <span data-extras-context></span></legend>
            <div class="wizard-extras" data-extras></div>
          </fieldset>
          <div class="wizard-nav">
            <button type="button" class="btn-ghost" data-back="1">← Back</button>
            <button type="button" class="btn-primary" data-calculate>Get My Estimate</button>
          </div>
        </div>

        <!-- STEP 3: ESTIMATE + CONTACT -->
        <div class="wizard-panel" data-step="3" hidden>
          <p class="wizard-hint">Step 3 of 3 · Your estimate &amp; contact info</p>
          <div class="wizard-estimate" style="display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; background:rgba(255,255,255,0.04); border:1px solid rgba(245,240,232,0.12); border-radius:12px; padding:1.25rem 1.5rem; margin-bottom:1.5rem;">
            <div>
              <span style="font-size:0.78rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--clay); font-weight:600;">Estimated Price Range</span>
              <div style="font-size:1.8rem; color:var(--straw); font-family:'Playfair Display',serif;" data-estimate-price>—</div>
            </div>
            <small style="color:rgba(245,240,232,0.5); max-width:220px; line-height:1.5;">Final price depends on site conditions. We'll confirm after a free visit.</small>
          </div>
          <form class="wizard-form" id="quote-form" data-submit-form novalidate>
            <div class="wizard-field">
              <label class="wizard-label" for="wizard-name">Full name *</label>
              <input id="wizard-name" type="text" autocomplete="name" placeholder="Jane Smith" data-field="customer_name">
            </div>
            <div class="wizard-row">
              <div class="wizard-field">
                <label class="wizard-label" for="wizard-email">Email</label>
                <input id="wizard-email" type="email" autocomplete="email" inputmode="email" placeholder="jane@example.com" data-field="customer_email">
              </div>
              <div class="wizard-field">
                <label class="wizard-label" for="wizard-phone">Phone *</label>
                <input id="wizard-phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(720) 707-5411" data-field="customer_phone">
              </div>
            </div>
            <div class="wizard-field">
              <label class="wizard-label" for="wizard-address">Property address *</label>
              <textarea id="wizard-address" rows="2" placeholder="123 Maple Ave, Longmont, CO" data-field="address"></textarea>
            </div>
            <div class="wizard-field">
              <label class="wizard-label" for="wizard-notes">Additional Notes</label>
              <textarea id="wizard-notes" rows="3" placeholder="Anything else we should know?" data-field="notes"></textarea>
            </div>
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAETW15T6VEdnpxQx" data-action="quote" data-theme="dark" style="margin-bottom:0.5rem;"></div>
            <div class="wizard-nav">
              <button type="button" class="btn-ghost" data-back="2">← Back</button>
              <button type="submit" class="btn-primary" data-submit>Submit Quote Request</button>
            </div>
            <p class="form-note">We reply within one business day.</p>
          </form>
        </div>

        <div class="wizard-banner" data-banner="success" role="status" hidden style="padding:2rem; text-align:center;">
          <div style="width:52px; height:52px; margin:0 auto 1rem; border-radius:50%; background:var(--clay); color:var(--cream); font-size:1.5rem; display:flex; align-items:center; justify-content:center;">✓</div>
          <strong style="font-size:1.2rem; color:var(--straw); font-family:'Playfair Display',serif;">Thank you! We'll contact you within 24 hours.</strong>
          <br><button type="button" class="btn-ghost" style="margin-top:1rem;" data-restart>Start New Quote</button>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" style="background:var(--straw);">
    <div class="section">
      <div class="services-intro">
        <div class="services-intro-left">
          <p class="section-label">What We Do</p>
          <h2 class="section-title">Every corner of your property, <em>cared for</em></h2>
        </div>
        <div class="services-intro-right">
          Over a decade of hands-on experience across landscaping, outdoor structures, and residential maintenance — all under one reliable crew.
        </div>
      </div>
      <div class="services-grid">
        {% for service in services %}
        <div class="service-card">
          <div class="card-num">{{ '0' + loop.index if loop.index < 10 else loop.index }}</div>
          <div class="card-icon"><svg class="icon"><use href="#{{ service.icon }}"/></svg></div>
          <h3>{{ service.title }}</h3>
          <p>{{ service.short }}</p>
          <a href="/services/{{ service.slug }}" class="service-card-link">Learn more →</a>
        </div>
        {% endfor %}
      </div>
    </div>

</section>

  <!-- PORTFOLIO SLIDESHOW -->
  <section style="background:var(--bark);">
    <div class="section">
      <p class="section-label" style="color:var(--clay);">Our Work</p>
      <h2 class="section-title" style="color:var(--straw);">Projects that speak for <em style="color:var(--clay);">themselves</em></h2>
      <div class="portfolio-slideshow">
        <div class="slideshow-container">
          <div class="slide active">
            <img src="images/walkwayafter.webp" alt="Stone Walkway" loading="lazy" width="790" height="1600" srcset="images/responsive/walkwayafter-480.webp 480w, images/walkwayafter.webp 790w" sizes="(max-width: 768px) 100vw, 60vw">
            <div class="slide-caption">
              <a href="/portfolio" class="btn-primary">View Portfolio</a>
            </div>
          </div>
          <div class="slide">
            <img src="images/wallafter.webp" alt="Retaining Wall" loading="lazy" width="1600" height="784" srcset="images/responsive/wallafter-480.webp 480w, images/responsive/wallafter-800.webp 800w, images/responsive/wallafter-1200.webp 1200w, images/wallafter.webp 1600w" sizes="(max-width: 768px) 100vw, 60vw">
            <div class="slide-caption">
              <a href="/portfolio" class="btn-primary">View Portfolio</a>
            </div>
          </div>
          <div class="slide">
            <img src="images/stairsafter.webp" alt="Custom Staircase" loading="lazy" width="1600" height="786" srcset="images/responsive/stairsafter-480.webp 480w, images/responsive/stairsafter-800.webp 800w, images/responsive/stairsafter-1200.webp 1200w, images/stairsafter.webp 1600w" sizes="(max-width: 768px) 100vw, 60vw">
            <div class="slide-caption">
              <a href="/portfolio" class="btn-primary">View Portfolio</a>
            </div>
          </div>
          <div class="slide">
            <img src="images/after/green-house-after.webp" alt="Green House" loading="lazy" width="1600" height="534" srcset="images/responsive/after_green-house-after-480.webp 480w, images/responsive/after_green-house-after-800.webp 800w, images/responsive/after_green-house-after-1200.webp 1200w, images/after/green-house-after.webp 1600w" sizes="(max-width: 768px) 100vw, 60vw">
            <div class="slide-caption">
              <a href="/portfolio" class="btn-primary">View Portfolio</a>
            </div>
          </div>
          <div class="slide">
            <img src="images/after/lawn-after.webp" alt="Lawn" loading="lazy" width="1600" height="782" srcset="images/responsive/after_lawn-after-480.webp 480w, images/responsive/after_lawn-after-800.webp 800w, images/responsive/after_lawn-after-1200.webp 1200w, images/after/lawn-after.webp 1600w" sizes="(max-width: 768px) 100vw, 60vw">
            <div class="slide-caption">
              <a href="/portfolio" class="btn-primary">View Portfolio</a>
            </div>
          </div>
          <div class="slide">
            <img src="images/after/yellow-house-after.webp" alt="Yellow House" loading="lazy" width="1600" height="784" srcset="images/responsive/after_yellow-house-after-480.webp 480w, images/responsive/after_yellow-house-after-800.webp 800w, images/responsive/after_yellow-house-after-1200.webp 1200w, images/after/yellow-house-after.webp 1600w" sizes="(max-width: 768px) 100vw, 60vw">
            <div class="slide-caption">
              <a href="/portfolio" class="btn-primary">View Portfolio</a>
            </div>
          </div>
        </div>
        <button class="prev" type="button" aria-label="Previous slide">&#10094;</button>
        <button class="next" type="button" aria-label="Next slide">&#10095;</button>
      </div>
    </div>
  </section>

  <!-- ABOUT SUMMARY -->
  <section style="background:var(--cream);">
    <div class="section">
      <div class="about-layout">
        <div class="about-text">
          <p class="section-label">Who We Are</p>
          <h2 class="section-title">Reliable &amp; <em>Honest</em> Property Care</h2>
          <p>With over a decade of hands-on building, landscaping, and residential maintenance experience, we treat every property like our own. From crisp lawn edges to durable outdoor repairs, we focus on sharp attention to detail, reliable communication, and honest work.</p>
          <a href="/about" class="btn-primary">Learn More About Us</a>
        </div>
        <div class="about-visual">
          <img class="about-img"
            src="images/about-garden.webp"
            alt="Garden maintenance work" loading="lazy"
            width="800" height="533"
            srcset="images/responsive/about-garden-480.webp 480w, images/about-garden.webp 800w"
            sizes="(max-width: 768px) 100vw, 45vw">
        </div>
      </div>
    </div>
  </section>

  <!-- WHY HOMEOWNERS CHOOSE US -->
  <section id="why-us" style="background:var(--straw);">
    <div class="section">
      <p class="section-label">Why Homeowners Choose Us</p>
      <h2 class="section-title">The Property Care <em>difference</em></h2>
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <h3 style="font-family:'Playfair Display', serif; color:var(--bark); font-size:1.15rem; margin-bottom:0.5rem;">Honest, itemized estimates</h3>
          <p>No surprise charges. Every quote is free, no-obligation, and spelled out before we start.</p>
        </div>
        <div class="testimonial-card">
          <h3 style="font-family:'Playfair Display', serif; color:var(--bark); font-size:1.15rem; margin-bottom:0.5rem;">We treat every yard like our own</h3>
          <p>Same crew, same attention to detail, whether it's a one-time cleanup or a standing weekly mow.</p>
        </div>
        <div class="testimonial-card">
          <h3 style="font-family:'Playfair Display', serif; color:var(--bark); font-size:1.15rem; margin-bottom:0.5rem;">Local, licensed, and easy to reach</h3>
          <p>Based in Longmont, licensed &amp; insured, and we respond within 24 hours — every time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CUSTOMER REVIEWS -->
  <section id="reviews" style="display:none; background:var(--cream);">
    <div class="section">
      <p class="section-label">Testimonials</p>
      <h2 class="section-title">What homeowners are <em>saying</em></h2>
      <div class="testimonials-grid" id="customer-reviews"></div>
    </div>
  </section>

  <!-- SERVICE AREA -->
  <section style="background:var(--bark);">
    <div class="section" style="text-align:center;">
      <p class="section-label" style="color:var(--clay);">Service Area</p>
      <h2 class="section-title" style="color:var(--straw);">Proudly serving the <em style="color:var(--clay);">Front Range</em></h2>
      <p style="color:rgba(245,240,232,0.6); max-width: 42rem; margin: 0 auto 3rem;">
        Proudly serving {{ site.areas | join(', ') }}.
      </p>
      <div class="area-grid">
        {% for area in areas %}{% if area.featured %}
        <a class="area-card" href="/service-areas/{{ area.slug }}" style="text-decoration:none; display:block;">
          <svg class="icon" style="width:1.5rem;height:1.5rem;color:var(--clay);"><use href="#icon-pin"/></svg>
          <h3>{{ area.name }}</h3>
          <p>{{ area.blurb }}</p>
        </a>
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" style="background:var(--cream);">
    <div class="section">
      <p class="section-label">Questions?</p>
      <h2 class="section-title">Frequently asked <em>questions</em></h2>
      <div class="faq-container" data-aos="fade-up">
        <div class="faq-item" id="faq1">
          <button class="faq-trigger" id="faq1-trigger" aria-expanded="false" aria-controls="faq1-answer" aria-label="Toggle answer for Do you provide estimates?">
            <span class="faq-question">Do you provide estimates?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq1-answer" role="region" aria-labelledby="faq1-trigger">
            <p>Yes! We offer free, no-obligation estimates for all services. Contact us or fill out the form above to request one.</p>
          </div>
        </div>
        <div class="faq-item" id="faq2">
          <button class="faq-trigger" id="faq2-trigger" aria-expanded="false" aria-controls="faq2-answer" aria-label="Toggle answer for Are you licensed and insured?">
            <span class="faq-question">Are you licensed and insured?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq2-answer" role="region" aria-labelledby="faq2-trigger">
            <p>Absolutely. We're fully licensed, insured, and bonded to protect you and your property.</p>
          </div>
        </div>
        <div class="faq-item" id="faq3">
          <button class="faq-trigger" id="faq3-trigger" aria-expanded="false" aria-controls="faq3-answer" aria-label="Toggle answer for What areas do you serve?">
            <span class="faq-question">What areas do you serve?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq3-answer" role="region" aria-labelledby="faq3-trigger">
            <p>We serve {{ site.areas | join(', ') }}. Contact us to see if your area is covered.</p>
          </div>
        </div>
        <div class="faq-item" id="faq4">
          <button class="faq-trigger" id="faq4-trigger" aria-expanded="false" aria-controls="faq4-answer" aria-label="Toggle answer for Can you work on weekends?">
            <span class="faq-question">Can you work on weekends?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq4-answer" role="region" aria-labelledby="faq4-trigger">
            <p>We work Saturday mornings by request. Sunday is our rest day. Contact us to arrange weekend scheduling.</p>
          </div>
        </div>
        <div class="faq-item" id="faq5">
          <button class="faq-trigger" id="faq5-trigger" aria-expanded="false" aria-controls="faq5-answer" aria-label="Toggle answer for How do I schedule a service?">
            <span class="faq-question">How do I schedule a service?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq5-answer" role="region" aria-labelledby="faq5-trigger">
            <p>Call us at <a href="tel:{{ site.phone }}" style="color:var(--clay); font-weight:600;">{{ site.phoneDisplay }}</a>, <a href="mailto:{{ site.email }}" style="color:var(--clay); font-weight:600;">email us</a>, or use the contact form above. We respond within 24 hours.</p>
          </div>
        </div>
        <div class="faq-item" id="faq6">
          <button class="faq-trigger" id="faq6-trigger" aria-expanded="false" aria-controls="faq6-answer" aria-label="Toggle answer for What payment methods do you accept?">
            <span class="faq-question">What payment methods do you accept?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq6-answer" role="region" aria-labelledby="faq6-trigger">
            <p>We accept cash, check, Venmo, and all major credit cards. Invoice billing available for regular clients.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GUARANTEE -->
  <section style="background:var(--straw); text-align:center;">
    <div class="section">
      <div style="max-width:640px; margin:0 auto;">
        <svg class="icon" style="width:3rem;height:3rem;color:var(--bark);margin-bottom:1rem;"><use href="#icon-shield"/></svg>
        <h2 class="section-title" style="margin-bottom:0.75rem;">100% Satisfaction <em>Guaranteed</em></h2>
        <p style="color:var(--warm-mid); font-size:1rem; line-height:1.7;">If you're not happy with the work, we'll make it right — no questions asked. Every job is backed by our promise of honest, reliable service.</p>
      </div>
    </div>
  </section>

<!-- CONTACT -->
  <section id="contact" style="background:var(--bark);">
    <div class="section">
      <p class="section-label" style="color:var(--clay);">Get In Touch</p>
      <h2 class="section-title" style="color:var(--straw);">Request a Free <em style="color:var(--clay);">Estimate</em></h2>
      <div class="contact-layout">
        <div class="contact-intro">
          <p>Need a quote for your next home or property maintenance project? Send a quick message and we'll respond promptly with availability and pricing.</p>
          <div class="contact-detail">
            <strong>Call</strong> <a href="tel:{{ site.phone }}">{{ site.phoneDisplay }}</a>
          </div>
          <div class="contact-detail">
            <strong>Text</strong> <a href="sms:{{ site.phone }}">{{ site.phoneDisplay }}</a>
          </div>

        </div>
        <form class="contact-form" name="contact" method="POST" action="{{ root }}submit-form" data-contact-form>
          <input type="hidden" name="form-name" value="contact" />
          <input type="text" name="bot-field" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true">
          <h3 style="font-family:'Playfair Display',serif; color:var(--straw); font-size:1.3rem; margin:0 0 0.25rem;">Request a Free Quote</h3>
          <p style="color:rgba(245,240,232,0.65); font-size:0.95rem; margin:0 0 1.25rem;">Used the calculator above? Send your details here and we'll follow up with a firm, itemized quote — or just reach out to talk through your project.</p>
          <div class="form-row">
            <div class="form-group">
              <label for="name">Full name *</label>
              <input type="text" id="name" name="name" placeholder="Jane Smith" required autocomplete="name">
            </div>
            <div class="form-group">
              <label for="phone">Phone *</label>
              <input type="tel" id="phone" name="phone" placeholder="(720) 000-0000" required autocomplete="tel">
            </div>
          </div>
          <div class="form-group">
            <label for="address">Property address *</label>
            <input type="text" id="address" name="address" placeholder="123 Maple Ave, Longmont, CO" required autocomplete="street-address">
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email">
          </div>
          <div class="form-group">
            <label for="service-type">Service needed *</label>
            <select id="service-type" name="service-type" required data-service-select>
              <option value="">Select a service…</option>
              {% for s in services %}
              <option value="{{ s.title }}" data-slug="{{ s.slug }}">{{ s.title }}</option>
              {% endfor %}
              <option value="Not sure / Other">Not sure / Other</option>
            </select>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="preferred-date">Preferred date</label>
              <input type="date" id="preferred-date" name="preferred-date">
            </div>
            <div class="form-group">
              <label for="when">When?</label>
              <select id="when" name="when">
                <option>As soon as possible</option>
                <option>This week</option>
                <option>Next 2 weeks</option>
                <option>Just exploring</option>
              </select>
            </div>
          </div>
          <div class="form-group" data-estimate-field hidden>
            <label for="estimate">Estimated range from calculator</label>
            <input type="text" id="estimate" name="estimate" readonly data-estimate-input>
          </div>
          <div class="form-group">
            <label for="message">Tell us about the job *</label>
            <textarea id="message" name="message" rows="4" placeholder="e.g. Rotting fence posts near the back gate, need about 60 ft replaced…" required></textarea>
          </div>
          <label class="consent">
            <input type="checkbox" name="consent" value="yes" required>
            <span>I agree to be contacted about my request. No spam, ever.</span>
          </label>
          <div class="cf-turnstile" data-sitekey="0x4AAAAAAETW15T6VEdnpxQx" data-action="contact" data-theme="dark"></div>
          <button type="submit" class="btn-primary">Send My Request — Free Quote →</button>
          <p class="form-note" data-form-note>We reply within one business day.</p>
        </form>
      </div>
    </div>
  </section>
  <!-- NEWSLETTER -->
  <section id="newsletter" style="background:var(--cream);">
    <div class="section" style="text-align:center; padding:4rem 2.5rem;">
      <p class="section-label">Stay Updated</p>
      <h2 class="section-title" style="color:var(--bark);">Get tips &amp; <em style="color:var(--clay-deep);">updates</em></h2>
      <p style="color:var(--bark); font-size:1rem; max-width:500px; margin:1.5rem auto; opacity:0.7;">Join our mailing list for seasonal tips, discounts, and updates on new services.</p>
      <form class="newsletter-form" id="newsletterForm" name="newsletter" method="POST" action="{{ root }}submit-form" data-aos="fade-up">
  <input type="hidden" name="form-name" value="newsletter" />
  <input type="text" name="bot-field" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true">
  <input type="email" name="email" placeholder="your@email.com" required>
  <div class="cf-turnstile" data-sitekey="0x4AAAAAAETW15T6VEdnpxQx" data-action="newsletter" style="margin:0.75rem auto;"></div>
  <button type="submit" class="btn-primary">Subscribe</button>
  <label class="newsletter-consent">
    <input type="checkbox" name="consent" value="yes" required>
    <span>I agree to receive occasional updates from Property Care per our <a href="/privacy">privacy policy</a>.</span>
  </label>
</form>
  </section>

</main>
{% include "footer.njk" %}
{% include "scripts.njk" %}

</body>
</html>